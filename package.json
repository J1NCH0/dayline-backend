{
  "name": "dayline-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint src/ test/",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "prisma": "bun --bun --env-file=.env x prisma",
    "prisma:test": "bun --bun --env-file=.env.test x prisma",
    "prisma:generate": "bun run prisma generate",
    "prisma:migrate": "bun run prisma migrate dev",
    "prisma:deploy": "bun run prisma migrate deploy",
    "prisma:studio": "bun run prisma studio",
    "test": "bun test test/unit",
    "test:watch": "bun test --watch test/unit",
    "test:cov": "bun test --coverage",
    "test:e2e": "bun test test/e2e"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3"
  }
}
